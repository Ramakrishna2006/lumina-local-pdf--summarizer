# =====================================================================
# Lumina – configuration
# Copy this file to ".env" and change what you need.
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
# The real .env is git-ignored. Never commit API keys.
# =====================================================================

# ---- Server ----------------------------------------------------------
HOST=127.0.0.1
PORT=5001
LOG_LEVEL=INFO
# Browser addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ---- Storage ---------------------------------------------------------
DATABASE_URL=sqlite:///./storage/app.db
UPLOAD_DIR=storage/uploads
TEMP_DIR=storage/temporary
SUMMARY_DIR=storage/summaries
RAG_DIR=storage/rag
MAX_FILE_SIZE_MB=25
# Delete the original file after its text has been extracted
DELETE_SOURCE_AFTER_PROCESSING=false

# ---- Which AI engine? ------------------------------------------------
# ollama  = Ollama (default, recommended)
# openai  = any OpenAI-compatible server: LM Studio, llama.cpp llama-server,
#           vLLM, Jan, LocalAI ... (or a hosted API – then your text leaves the PC)
LLM_PROVIDER=ollama

# ---- Local LLM (Ollama) ---------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any chat model you have pulled, e.g. llama3.2:3b, qwen2.5:7b, gemma3:4b
OLLAMA_MODEL=llama3.2:3b
# Seconds to wait for the model once it has started on YOUR request
# (time spent waiting in the queue is not counted). CPU-only PCs need a lot.
LLM_TIMEOUT=600
# Requests sent to the model at the same time. Keep 1 on a CPU-only PC so
# your question always gets the whole processor; 2-4 can help with a GPU.
LLM_MAX_PARALLEL=1
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=700
# Smaller context = faster answers on CPU. 4096 is a good default.
LLM_NUM_CTX=4096
# Keep the model loaded between questions (faster follow-ups)
LLM_KEEP_ALIVE=2h

# ---- Speed-aware reading ------------------------------------------------
# Answers ALWAYS keep their full length. Lumina measures how fast YOUR computer
# runs the model; on a slow CPU it gives the model fewer, more focused passages
# (only the sentences that match the question) so the first word appears in
# about READ_TARGET_SECONDS. The writing speed itself depends on your CPU/GPU
# and the model size (llama3.2:1b writes 2-3x faster than llama3.2:3b).
ADAPTIVE_SPEED=true
READ_TARGET_SECONDS=15
SUMMARY_READ_TARGET_SECONDS=30
# Optional: stop writing after this many seconds (0 = never, answers complete)
ANSWER_HARD_LIMIT_SECONDS=0
# Load the model when the backend starts so the first answer is quick
LLM_WARMUP_ON_STARTUP=true
# How many earlier messages are remembered for follow-up questions
CHAT_HISTORY_MESSAGES=6
# CPU threads for Ollama (0 = automatic)
LLM_NUM_THREAD=0

# ---- OpenAI-compatible server (only when LLM_PROVIDER=openai) ----------
# LM Studio: http://127.0.0.1:1234/v1   llama.cpp: http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Leave empty for local servers. NEVER commit a real key – keep it only in .env
OPENAI_API_KEY=
OPENAI_MODEL=local-model
# Optional embedding model on that server (empty = keyword search)
OPENAI_EMBEDDING_MODEL=

# ---- Speed: instant answers for repeated questions -------------------
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_SIZE=300

# ---- Retrieval (RAG) --------------------------------------------------
RAG_ENABLED=true
# Run once:  ollama pull embeddinggemma
# Smart search is built in the background, so documents are usable at once.
# Slow PC? A smaller embedding model builds it 2-10x faster:
#   nomic-embed-text  (English, ~2x faster)   all-minilm  (English, ~8x faster)
# After changing it run:  python scripts/reindex_all_rag.py
RAG_EMBEDDING_MODEL=embeddinggemma
RAG_TOP_K=5
# Text from your documents given to the model per question. Smaller = the
# first word appears sooner on a CPU (the model reads ~50-150 words/second).
RAG_MAX_CONTEXT_CHARS=5000
# Chunks sent to the embedding model per request. Small batches let your
# questions "cut in line" while smart search is built in the background.
RAG_EMBED_BATCH=4
# How many document indexes stay in RAM
RAG_CACHE_SIZE=32
CHUNK_SIZE=1400
CHUNK_OVERLAP=200

# ---- Summaries --------------------------------------------------------
SUMMARY_MAX_CONTEXT_CHARS=9000
SUMMARY_MAX_TOKENS=900

# ---- Suggested questions -------------------------------------------
# false = instant, built from each document's key terms (recommended)
# true  = written by the AI model at low priority (nicer, but slow on CPU)
LLM_SUGGESTIONS=false

# ---- OCR (scanned PDFs and images) -----------------------------------
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# macOS/Linux: leave empty if "tesseract" is on your PATH
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_DPI=180
OCR_MIN_CHARS=120
OCR_WORKERS=4

# ---- Web research (optional) -----------------------------------------
WEB_RESEARCH_ENABLED=true
# Optional Google Programmable Search keys. Leave empty to use free sources.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
RESEARCH_MAX_TOKENS=800
